{
  "name": "adsense-smart-display",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build:renderer": "pnpm --filter @adsense/renderer build",
    "deploy:web": "pnpm --filter @adsense/web deploy",
    "gen:shared": "pnpm --filter @adsense/shared generate",
    "typecheck": "pnpm --filter @adsense/shared typecheck && pnpm --filter @adsense/web typecheck",
    "test": "pnpm --filter @adsense/shared test && pnpm --filter @adsense/web test"
  }
}
