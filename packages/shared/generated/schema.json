{
  "$ref": "#/definitions/SharedContract",
  "definitions": {
    "SharedContract": {
      "type": "object",
      "properties": {
        "health": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            },
            "contractVersion": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            }
          },
          "required": [
            "ok",
            "contractVersion",
            "environment"
          ],
          "additionalProperties": false
        },
        "sessionClaims": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "admin",
                "device"
              ]
            },
            "issuedAt": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "expiresAt": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "deviceId": {
              "$ref": "#/definitions/SharedContract/properties/sessionClaims/properties/subject"
            }
          },
          "required": [
            "subject",
            "kind",
            "issuedAt",
            "expiresAt"
          ],
          "additionalProperties": false
        },
        "device": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/SharedContract/properties/sessionClaims/properties/subject"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "lastSeenAt": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SharedContract/properties/device/properties/createdAt"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "name",
            "createdAt",
            "lastSeenAt"
          ],
          "additionalProperties": false
        },
        "offer": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/SharedContract/properties/sessionClaims/properties/subject"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "locale": {
              "type": "string",
              "enum": [
                "en",
                "ro"
              ]
            },
            "imageKey": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "active": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "title",
            "description",
            "locale",
            "imageKey",
            "active"
          ],
          "additionalProperties": false
        },
        "redemption": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/SharedContract/properties/sessionClaims/properties/subject"
            },
            "offerId": {
              "$ref": "#/definitions/SharedContract/properties/sessionClaims/properties/subject"
            },
            "deviceId": {
              "$ref": "#/definitions/SharedContract/properties/sessionClaims/properties/subject"
            },
            "redeemedAt": {
              "$ref": "#/definitions/SharedContract/properties/device/properties/createdAt"
            }
          },
          "required": [
            "id",
            "offerId",
            "deviceId",
            "redeemedAt"
          ],
          "additionalProperties": false
        },
        "bleAuthMode": {
          "type": "string",
          "enum": [
            "none",
            "psk",
            "pairing"
          ]
        },
        "bleHello": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hello"
            },
            "deviceId": {
              "$ref": "#/definitions/SharedContract/properties/sessionClaims/properties/subject"
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            },
            "authMode": {
              "$ref": "#/definitions/SharedContract/properties/bleAuthMode"
            }
          },
          "required": [
            "type",
            "deviceId",
            "nonce",
            "authMode"
          ],
          "additionalProperties": false
        },
        "bleWifiCredentials": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wifi_credentials"
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "password": {
              "type": "string",
              "maxLength": 128
            }
          },
          "required": [
            "type",
            "ssid",
            "password"
          ],
          "additionalProperties": false
        },
        "bleWifiStatus": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wifi_status"
            },
            "connected": {
              "type": "boolean"
            },
            "error": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "type",
            "connected"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "health",
        "sessionClaims",
        "device",
        "offer",
        "redemption",
        "bleAuthMode",
        "bleHello",
        "bleWifiCredentials",
        "bleWifiStatus"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
