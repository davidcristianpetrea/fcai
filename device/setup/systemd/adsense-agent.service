[Unit]
Description=AdSense device agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=adsense
Group=adsense
WorkingDirectory=/opt/adsense
Environment=ADSENSE_PLATFORM=pi
Environment=ADSENSE_DATA_DIR=/etc/adsense/state
ExecStart=/opt/adsense/.venv/bin/adsense-agent
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/adsense/state

[Install]
WantedBy=multi-user.target
