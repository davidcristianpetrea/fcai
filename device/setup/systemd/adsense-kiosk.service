[Unit]
Description=AdSense Chromium kiosk
After=graphical.target adsense-agent.service adsense-vision.service
Wants=adsense-agent.service adsense-vision.service

[Service]
Type=simple
User=adsense
Group=adsense
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/cage -- /opt/adsense/chromium-kiosk.sh
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=graphical.target
