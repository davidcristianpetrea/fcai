{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adsense-smart-display",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/offer*"]
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
