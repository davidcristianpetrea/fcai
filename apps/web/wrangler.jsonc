{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adsense-smart-display",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adsense-smart-display",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "adsense-smart-display-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_HUB",
        "class_name": "DeviceHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceHub"]
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/offer*"]
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
